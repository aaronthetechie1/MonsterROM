From cf9b438bc847d171dcfd6b54cd2c134052e982b0 Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Fri, 17 Oct 2025 12:02:03 +0200
Subject: [PATCH] Enable real time network speed in status bar

---
 .../ConfigureNotificationMoreSettings$1.smali | 14 ++--------
 .../StatusBarNetworkSpeedController.smali     | 14 ++--------
 .../provider/items/NotificationsItem.smali    | 4 ++++
 3 files changed, 6 insertions(+), 26 deletions(-)

diff --git a/smali_classes3/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali b/smali_classes3/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali
index 321d0ed7a..0d7fdfb3f 100644
--- a/smali_classes3/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali
+++ b/smali_classes3/com/samsung/android/settings/notification/ConfigureNotificationMoreSettings$1.smali
@@ -5,7 +5,7 @@

 # virtual methods
 .method public final getNonIndexableKeys(Landroid/content/Context;)Ljava/util/List;
-    .locals 3
+    .locals 2

     invoke-super {p0, p1}, Lcom/android/settings/search/BaseSearchIndexProvider;->getNonIndexableKeys(Landroid/content/Context;)Ljava/util/List;

@@ -37,17 +37,7 @@
     invoke-virtual {v1, v0}, Ljava/util/ArrayList;->add(Ljava/lang/Object;)Z

     :cond_1
-    invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
-
-    move-result-object v0
-
-    const-string v1, "CscFeature_Common_SupportZProjectFunctionInGlobal"
-
-    const/4 v2, 0x0
-
-    invoke-virtual {v0, v1, v2}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
-
-    move-result v0
+    const/4 v0, 0x1

     if-nez v0, :cond_2

diff --git a/smali_classes3/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali b/smali_classes3/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
index ad56af565..e00810787 100644
--- a/smali_classes3/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
+++ b/smali_classes3/com/samsung/android/settings/notification/StatusBarNetworkSpeedController.smali
@@ -22,19 +22,9 @@

 # direct methods
 .method static constructor <clinit>()V
-    .locals 3
+    .locals 1

-    invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
-
-    move-result-object v0
-
-    const-string v1, "CscFeature_Common_SupportZProjectFunctionInGlobal"
-
-    const/4 v2, 0x0
-
-    invoke-virtual {v0, v1, v2}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
-
-    move-result v0
+    const/4 v0, 0x1

     sput-boolean v0, Lcom/samsung/android/settings/notification/StatusBarNetworkSpeedController;->SUPPORT_NETWORK_SPEED:Z

diff --git a/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali b/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
--- a/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
+++ b/smali_classes3/com/samsung/android/settings/eternal/provider/items/NotificationsItem.smali
@@ -509,28 +509,30 @@ public final getValue(Landroid/content/Context;Lcom/samsung/android/lib/episode/SourceInfo;Ljava/lang/String;)Lcom/samsung/android/lib/episode/Scene$Builder;
 
     if-eqz v2, :cond_0
 
     invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
 
     move-result-object v0
 
     const-string v2, "CscFeature_Common_SupportZProjectFunctionInGlobal"
 
     const/4 v3, 0x0
 
     invoke-virtual {v0, v2, v3}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
 
     move-result v0
+
+    const/4 v0, 0x1
 
     if-eqz v0, :cond_1f
 
     const-string v0, "network_speed"
 
     invoke-static {v15, v0, v3}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
 
     move-result v0
 
     invoke-static {v0}, Ljava/lang/Integer;->valueOf(I)Ljava/lang/Integer;
 
     move-result-object v2
 
     invoke-virtual {v14, v2}, Lcom/samsung/android/lib/episode/Scene$Builder;->setValue(Ljava/lang/Object;)Lcom/samsung/android/lib/episode/Scene$Builder;
@@ -2073,28 +2075,30 @@ public final setValue(Landroid/content/Context;Ljava/lang/String;Lcom/samsung/android/lib/episode/Scene;Lcom/samsung/android/lib/episode/SourceInfo;)Lcom/samsung/android/lib/episode/SceneResult;
     if-eqz v0, :cond_f
 
     invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
 
     move-result-object v0
 
     const-string v2, "CscFeature_Common_SupportZProjectFunctionInGlobal"
 
     const/4 v3, 0x0
 
     invoke-virtual {v0, v2, v3}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
 
     move-result v0
 
+    const/4 v0, 0x1
+
     if-eqz v0, :cond_4
 
     const-string v0, "network_speed"
 
     invoke-static {v13}, Ljava/lang/Integer;->valueOf(Ljava/lang/String;)Ljava/lang/Integer;
 
     move-result-object v2
 
     invoke-virtual {v2}, Ljava/lang/Integer;->intValue()I
 
     move-result v2
 
     invoke-static {v12, v0, v2}, Landroid/provider/Settings$System;->putInt(Landroid/content/ContentResolver;Ljava/lang/String;I)Z
 

--
2.51.1
