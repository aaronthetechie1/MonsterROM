From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Thu, 1 Oct 2026 04:44:57 +0200
Subject: [PATCH] Allow disable ASKS

---
 .../server/asks/ASKSManagerService.smali       | 18 ++++++++----------
 1 file changed, 8 insertions(+), 10 deletions(-)

diff --git a/smali/com/android/server/asks/ASKSManagerService.smali b/smali/com/android/server/asks/ASKSManagerService.smali
index 40692f2..380a5a0 100644
--- a/smali/com/android/server/asks/ASKSManagerService.smali
+++ b/smali/com/android/server/asks/ASKSManagerService.smali
@@ -4676,16 +4676,14 @@
     move-object p1, v0

     :goto_0
-    const-string/jumbo v1, "ro.build.official.release"
+    const-string/jumbo v1, "persist.sys.unica.asks"

-    const-string/jumbo v2, "false"
+    const-string/jumbo v2, "true"

     invoke-static {v1, v2}, Landroid/os/SystemProperties;->get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;

     move-result-object v1

-    const-string/jumbo v2, "true"
-
     invoke-virtual {v2, v1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z

     move-result v1
@@ -28544,9 +28542,9 @@
     :cond_6
     const-string/jumbo v0, "true"

-    const-string/jumbo v1, "ro.build.official.release"
+    const-string/jumbo v1, "persist.sys.unica.asks"

-    const-string/jumbo v2, "false"
+    const-string/jumbo v2, "true"

     invoke-static {v1, v2}, Landroid/os/SystemProperties;->get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;

@@ -30560,13 +30558,13 @@

     invoke-virtual {v6, v10}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z

-    const-string/jumbo v6, "ro.build.official.release"
+    const-string/jumbo v6, "persist.sys.unica.asks"

-    invoke-static {v6}, Landroid/os/SystemProperties;->get(Ljava/lang/String;)Ljava/lang/String;
+    const-string/jumbo v10, "true"

-    move-result-object v6
+    invoke-static {v6, v10}, Landroid/os/SystemProperties;->get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;

-    const-string/jumbo v10, "true"
+    move-result-object v6

     invoke-virtual {v10, v6}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z

