+
+    invoke-virtual {v7}, Lcom/android/systemui/edgelighting/effect/data/EdgeEffectInfo;->enableMultiResolution()V
 
     iget-object v9, v3, Lcom/android/systemui/edgelighting/scheduler/LightingScheduleInfo;->mLightingInfo:Lcom/samsung/android/edge/SemEdgeLightingInfo;
 
diff --git a/smali_classes2/com/android/systemui/edgelighting/scheduler/EdgeLightingScheduler$1.smali b/smali_classes2/com/android/systemui/edgelighting/scheduler/EdgeLightingScheduler$1.smali
