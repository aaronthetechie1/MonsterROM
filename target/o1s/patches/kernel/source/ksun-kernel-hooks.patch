diff --git a/fs/exec.c b/fs/exec.c
index 18e8fea7e..3ecd8de20 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1959,6 +1959,9 @@ int do_execveat(int fd, struct filename *filename,
 {
 	struct user_arg_ptr argv = { .ptr.native = __argv };
 	struct user_arg_ptr envp = { .ptr.native = __envp };
+#if defined(CONFIG_KSU_MANUAL_HOOK)
+	ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
+#endif
 	return do_execveat_common(fd, filename, argv, envp, flags);
 }
 
diff --git a/fs/stat.c b/fs/stat.c
index 7ef48a877..a0bba46a5 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -404,13 +404,22 @@ SYSCALL_DEFINE4(newfstatat, int, dfd, const char __user *, filename,
 }
 #endif
 
+#if defined(CONFIG_KSU_MANUAL_HOOK)
+extern void ksu_handle_newfstat_ret(unsigned int *fd, struct stat __user **statbuf_ptr);
+#endif
+
 SYSCALL_DEFINE2(newfstat, unsigned int, fd, struct stat __user *, statbuf)
 {
 	struct kstat stat;
 	int error = vfs_fstat(fd, &stat);
 
-	if (!error)
+	if (!error) {
 		error = cp_new_stat(&stat, statbuf);
+#if defined(CONFIG_KSU_MANUAL_HOOK)
+		if (!error)
+			ksu_handle_newfstat_ret(&fd, &statbuf);
+#endif
+	}
 
 	return error;
 }
diff --git a/kernel/reboot.c b/kernel/reboot.c
index cf442eba1..eda5110d4 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -330,8 +330,8 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	int ret = 0;
 
 #ifdef CONFIG_KSU_MANUAL_HOOK
-	ret = ksu_handle_sys_reboot(magic1, magic2, cmd, &arg);
-	if (!ret)
+	(void)ksu_handle_sys_reboot(magic1, magic2, cmd, &arg);
+	if (magic1 == 0xDEADBEEF)
 		return 0;
 	ret = 0;
 #endif
diff --git a/kernel/seccomp.c b/kernel/seccomp.c
index 1ec9bdc1e..51b3eae86 100644
--- a/kernel/seccomp.c
+++ b/kernel/seccomp.c
@@ -25,6 +25,7 @@
 #include <linux/sched.h>
 #include <linux/sched/task_stack.h>
 #include <linux/seccomp.h>
+#include <asm/unistd.h>
 #include <linux/slab.h>
 #include <linux/syscalls.h>
 #include <linux/sysctl.h>
@@ -1239,6 +1240,14 @@ int __secure_computing(const struct seccomp_data *sd)
 	this_syscall = sd ? sd->nr :
 		syscall_get_nr(current, current_pt_regs());
 
+#ifdef CONFIG_KSU
+	if (unlikely(this_syscall == __NR_reboot)) {
+		struct pt_regs *regs = current_pt_regs();
+		if (regs && (u32)regs->regs[0] == 0xDEADBEEF)
+			return 0;
+	}
+#endif
+
 	switch (mode) {
 	case SECCOMP_MODE_STRICT:
 		__secure_computing_strict(this_syscall);  /* may call do_exit */
